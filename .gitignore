# Secrets y credenciales (NUNCA subir)
.env
.env.local
.env.production
.env.staging
!.env.example
*.key
*.pem
credentials.json
secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Entornos virtuales
.venv/
venv/
env/
ENV/
.pyenv/

# Testing y coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Base de datos local (conversaciones, sesiones)
*.db
*.sqlite
*.sqlite3
data/
db/

# Logs
*.log
logs/

# Editores
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Sistema operativo
desktop.ini
$RECYCLE.BIN/

# Backups
*.bak
*.backup
*.old

# Archivos temporales del proyecto
*.tmp
temp/
tmp/

# Documentacion generada
docs/_build/
site/
