# Variables de entorno del bot KitraDep
# ----------------------------------------------------------------------------
# 1. Copia este archivo a `.env` (sin el `.example`)
# 2. Reemplaza los valores por los tuyos
# 3. NUNCA subas el `.env` a git (esta ignorado en .gitignore)
# ----------------------------------------------------------------------------

# --- LLM ---
# Backend: 'fake' (offline, sin costo) o 'gemini' (real, requiere API key)
LLM_BACKEND=fake
# API key de Google Gemini. Obtene una gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...pegar_aqui_tu_key
# Modelo(s) a usar, separados por coma. Si el primero falla o tarda mas de
# 12 s, el bot prueba el siguiente (cada modelo tiene su propia cuota gratis
# diaria). La velocidad de cada modelo varia de un dia a otro: verifica
# cuales acepta tu key corriendo: python check_gemini.py
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# --- Persistencia ---
# Ruta del archivo SQLite (por defecto data/kitradep.db)
DB_PATH=data/kitradep.db

# --- Servidor web ---
HOST=127.0.0.1
PUERTO=8765
# 1 = abre el navegador al arrancar (util en local), 0 = no (produccion/Docker)
ABRIR_NAVEGADOR=1

# --- Comportamiento del bot ---
# A que contacto deriva el bot cuando pide humano (nombre o numero)
HANDOFF_CONTACTO=nuestro equipo
MAX_TURNOS_MEMORIA=20

# --- Rate limiting (anti-abuso) ---
RATE_LIMIT_MENSAJES=30
RATE_LIMIT_VENTANA_S=60

# --- Notificaciones al staff (email SMTP, opcional) ---
# Si no se configuran, las notificaciones se muestran en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIF_EMAIL_TO=

# --- Backups a Backblaze B2 (opcional, usado por scripts/backup.py) ---
B2_ENDPOINT_URL=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
BACKUP_RETENCION_DIAS=30

# --- Simulador publico (Vercel) ---
# Si se define, el simulador pide esta clave antes de entrar (para que solo
# lo usen los kinesiologos). Vacio = sin clave (PC y servidor AWS).
SIMULADOR_CLAVE=

# --- WhatsApp: Twilio Sandbox (Fase 4-B, demo) ---
# Auth Token de la consola de Twilio (Account Info). Valida que los POST a
# /webhook vengan de Twilio. Vacio = sin validar (solo pruebas locales).
TWILIO_AUTH_TOKEN=
# URL exacta que se registra en el Sandbox de Twilio ("When a message comes in")
WEBHOOK_URL_PUBLICA=https://3-20-141-102.sslip.io/webhook

# --- WhatsApp: Meta Cloud API (Fase 4-C, aun no implementado) ---
# META_WHATSAPP_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=
