# Variables de entorno del bot KitraDep
# ----------------------------------------------------------------------------
# 1. Copia este archivo a `.env` (sin el `.example`)
# 2. Reemplaza los valores por los tuyos
# 3. NUNCA subas el `.env` a git (esta ignorado en .gitignore)
# ----------------------------------------------------------------------------

# API key de Google Gemini (Fase 3 en adelante)
# Obtener en: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...pegar_aqui_tu_key

# Modelo a usar (opcional, por defecto: gemini-2.0-flash-exp)
GEMINI_MODEL=gemini-2.0-flash-exp

# --- WhatsApp (Fase 4 en adelante, opcional por ahora) ---

# Twilio (Sandbox WhatsApp - Fase 4-B)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta Cloud API (produccion - Fase 4-C)
# META_WHATSAPP_TOKEN=EAAxxxxxxxxxxxx
# META_PHONE_NUMBER_ID=1234567890
# META_VERIFY_TOKEN=un_string_secreto_que_inventas_tu

# --- Notificaciones al staff ---

# Email (SMTP) para avisar cuando alguien agenda
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=felipe@ejemplo.cl
# SMTP_PASSWORD=xxx
# NOTIF_EMAIL_TO=agenda@kitradep.cl

# WhatsApp interno de handoff (a quien deriva el bot)
# HANDOFF_WHATSAPP=+56 9 XXXX XXXX
