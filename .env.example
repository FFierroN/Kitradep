# Variables de entorno del bot KitraDep
# ----------------------------------------------------------------------------
# 1. Copia este archivo a `.env` (sin el `.example`)
# 2. Reemplaza los valores por los tuyos
# 3. NUNCA subas el `.env` a git (esta ignorado en .gitignore)
# ----------------------------------------------------------------------------

# --- LLM ---
# Backend: 'fake' (offline, sin costo) o 'gemini' (real, requiere API key)
LLM_BACKEND=fake
# API key de Google Gemini. Obtene una gratis en https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...pegar_aqui_tu_key
GEMINI_MODEL=gemini-2.0-flash-exp

# --- Persistencia ---
# Ruta del archivo SQLite (por defecto data/kitradep.db)
DB_PATH=data/kitradep.db

# --- Servidor web ---
HOST=127.0.0.1
PUERTO=8765
# 1 = abre el navegador al arrancar (util en local), 0 = no (produccion/Docker)
ABRIR_NAVEGADOR=1

# --- Comportamiento del bot ---
# A que contacto deriva el bot cuando pide humano (nombre o numero)
HANDOFF_CONTACTO=nuestro equipo
MAX_TURNOS_MEMORIA=20

# --- Rate limiting (anti-abuso) ---
RATE_LIMIT_MENSAJES=30
RATE_LIMIT_VENTANA_S=60

# --- Notificaciones al staff (email SMTP, opcional) ---
# Si no se configuran, las notificaciones se muestran en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIF_EMAIL_TO=

# --- Backups a Backblaze B2 (opcional, usado por scripts/backup.py) ---
B2_ENDPOINT_URL=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
BACKUP_RETENCION_DIAS=30

# --- WhatsApp (Fase 4, aun no implementado) ---
# Twilio Sandbox
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
